[Unit]
Description=TrustBound private readiness API (public execution BLOCKED)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trustbound-web
Group=trustbound-web
WorkingDirectory=/srv/trustbound/pointers/current
EnvironmentFile=/etc/trustbound/backend.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/trustbound/pointers/current/.venv/bin/python -B -m uvicorn trustbound.api:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=300
UMask=0077
StateDirectory=trustbound
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/trustbound
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock -/run/user
CapabilityBoundingSet=
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=1G
TasksMax=128
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
