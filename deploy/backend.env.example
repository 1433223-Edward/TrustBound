# Install outside the repository as /etc/trustbound/backend.env, root-owned mode 0600.
# Private defaults. The Stage 5C runbook documents the opt-in and quota ledger.
TRUSTBOUND_LOAD_DOTENV=0
TRUSTBOUND_ENABLE_LIVE=0
TRUSTBOUND_ENABLE_RECOVERY_LIVE=0
VULTR_INFERENCE_API_KEY=
VULTR_MODEL=deepseek-v4.1-flash-1017
TRUSTBOUND_ENABLE_CUSTOM_TASK=0
TRUSTBOUND_PUBLIC_DEMO=0
# TRUSTBOUND_PUBLIC_DOMAIN=
# TRUSTBOUND_QUOTA_DB=/var/lib/trustbound/stage5c.sqlite3
# TRUSTBOUND_MAX_RUNS=40
# TRUSTBOUND_MIN_RUN_SECONDS=5
# TRUSTBOUND_MAX_MODEL_CALLS=0
# TRUSTBOUND_MAX_OUTPUT_TOKENS=0
